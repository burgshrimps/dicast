# Coverage config for the dicast unit-test suite.
#
# The only exclusion beyond the standard `pragma: no cover` is the top-level
# `if __name__ == "__main__":` block in dicast.py — that block is the CLI
# entrypoint glue (argument dispatch, process orchestration) and is exercised by
# end-to-end pipeline runs, not unit tests. Excluding it keeps the coverage
# denominator focused on the unit-testable function bodies.
[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
